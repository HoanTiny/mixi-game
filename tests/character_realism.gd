extends SceneTree
const An := preload("res://scripts/world/an_character.gd")
const Human := preload("res://scripts/world/human.gd")
const Character := preload("res://scripts/world/character.gd")
func _initialize() -> void:
	_run.call_deferred()
func _run() -> void:
	var an := An.new()
	root.add_child(an)
	an.setup(Color.WHITE, Color.WHITE)
	await process_frame
	assert(an.skeleton.get_bone_count() == 24)
	assert(an.animation.has_animation(an.walk_clip) and an.animation.has_animation(an.idle_clip))
	an.set_colors({"hair":"28231e", "shirt":"64735a", "pants":"3e414c"})
	assert(an.materials[0].get_shader_parameter("shirt_color").is_equal_approx(Color("64735a")), "source_color takes sRGB without preconversion")
	an.set_hair_style("neat")
	assert(an.hair_meshes[0].instance.mesh == an.hair_meshes[0].neat)
	an.animate_motion(1.5, 0.016)
	assert(an.walking and an.animation.current_animation == an.walk_clip)
	an.animate_motion(0.0, 0.016)
	assert(not an.walking and an.animation.current_animation == an.idle_clip)
	an.wear("cap", true, Color("64735a"))
	var cap: Node3D = an._worn.cap.node
	an.wear("cap", false)
	assert(not cap.visible)
	an.wear("cap", true, Color("6f777b"))
	assert(an._worn.cap.node == cap and an._worn.cap.material.albedo_color == Color("6f777b"))
	an.wear("cap", false)
	an.sit(true, 0.93)
	an.wear("helmet", true)
	an.animate_motion(4.0, 0.016)
	assert(an.sitting and not an.walking and an.animation.current_animation == an.idle_clip)
	an.animation.advance(0.3)
	an._ride_pose._apply()
	for side in ["Left", "Right"]:
		var sign := 1.0 if side == "Left" else -1.0
		for pair in [["Hand", Vector3(sign * 0.30, 1.095, 0.475)], ["Foot", Vector3(sign * 0.18, 0.43, 0.39)]]:
			var index := an.skeleton.find_bone(side + pair[0])
			var actual: Vector3 = an.skeleton.global_transform * an.skeleton.get_bone_global_pose(index).origin
			print(side, pair[0], " target error m=", actual.distance_to(pair[1]), " actual=", actual)
			assert(actual.distance_to(pair[1]) < 0.025, "Rider limbs must reach grips/foot rests without stretching")
		var palm := an.skeleton.get_bone_global_pose(an.skeleton.find_bone(side + "Hand")).basis.y.normalized()
		assert(palm.z > 0.9 and palm.y > -0.25, "Palms must lie over grips rather than hang vertically")
	var gaze := an.skeleton.get_bone_global_pose(an.skeleton.find_bone("Head")).basis.z.normalized()
	assert(gaze.z > 0.9 and gaze.y > -0.25, "Rider must look along the road")
	var helmet: Node3D = an._worn.helmet.node
	assert(helmet.get_child(0).scale.x > 90.0, "Centimeter skeleton must not shrink meter-scale helmet")
	an.sit(false, 0.93)
	an.wear("helmet", false)
	an.animate_motion(1.5, 0.016)
	an.animation.advance(0.3)
	assert(an.model.position.y == 0.0 and not an.sitting and an.walking)
	var cook := Human.make(Character.LOOKS.HANH)
	root.add_child(cook)
	await process_frame
	assert(cook._sk.get_bone_count() > 20 and cook._ap.has_animation("rb/sit"))
	var material: ShaderMaterial = Human._material("Chef_Female_01", "body", "", "cook")
	assert(material.get_shader_parameter("outfit_profile") == 1)
	assert(Human._material("Male_Adult_10", "body", "", "delivery").get_shader_parameter("outfit_profile") == 2)
	assert(Human._material("Male_Adult_10", "head", "", "delivery").get_shader_parameter("head_surface"))
	cook.sit(true, 0.9)
	assert(cook._state == "sit")
	cook.sit(false)
	cook.animate(0.016, 1.0)
	assert(cook._state == "walk")
	print("PASS: original skins, sRGB wardrobe, hair, animation transitions, reusable hats, reachable rider hands/feet, cook/delivery materials")
	quit()
